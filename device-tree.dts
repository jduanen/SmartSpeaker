/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	compatible = "allwinner,sun8iw18p1";
	#size-cells = <0x02>;
	model = "sun8iw18";
	#address-cells = <0x02>;

	pwm_dvfs_info {
		vol_max = <0x10d0b0>;
		vol_base = <0xcae18>;
		period_ns = <0xc350>;
		pwm_id = <0x07>;
		polarity = <0x00>;
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x00 0x8a 0x04 0x00 0x8b 0x04 0x00 0x8c 0x04 0x00 0x8d 0x04>;
	};

	prcm {
		compatible = "allwinner,prcm";
		reg = <0x00 0x1f01400 0x00 0x400>;
	};

	sunxi-chipid@03006200 {
		compatible = "allwinner,sunxi-chipid";
		device_type = "chipid";
		reg = <0x00 0x3006200 0x00 0x80>;
	};

	sram_a2 {
		compatible = "allwinner,sram_a2";
		reg = <0x00 0x40000 0x00 0x14000>;
	};

	opp_l_table0 {
		linux,phandle = <0x81>;
		compatible = "allwinner,opp_l_table0";
		opp-shared;
		opp_count = <0x03>;
		phandle = <0x81>;

		opp00 {
			opp-hz = <0x00 0x2aea5400>;
			clock-latency-ns = <0x1e8480>;
			opp-microvolt = <0xc8320>;
		};

		opp01 {
			opp-hz = <0x00 0x3c14dc00>;
			clock-latency-ns = <0x1e8480>;
			opp-microvolt = <0xdbba0>;
		};

		opp02 {
			opp-hz = <0x00 0x47868c00>;
			clock-latency-ns = <0x1e8480>;
			opp-microvolt = <0xf4240>;
		};
	};

	cpus {
		#size-cells = <0x00>;
		#address-cells = <0x01>;
		enable-method = "allwinner,sun8iw18p1";

		cpu@1 {
			compatible = "arm,cortex-a7\0arm,armv7";
			cpu-idle-states = <0x82 0x83 0x84>;
			operating-points-v2 = <0x81>;
			device_type = "cpu";
			clocks = <0x7f 0x80 0x02>;
			enable-method = "psci";
			reg = <0x01>;
			clock-names = "pll\0cpu\0periph0";
		};

		cpu@0 {
			compatible = "arm,cortex-a7\0arm,armv7";
			cpu-idle-states = <0x82 0x83 0x84>;
			operating-points-v2 = <0x81>;
			device_type = "cpu";
			clocks = <0x7f 0x80 0x02>;
			enable-method = "psci";
			reg = <0x00>;
			clock-names = "pll\0cpu\0periph0";
		};

		idle-states {
			entry-method = "arm,psci";

			sys-sleep-0 {
				linux,phandle = <0x84>;
				min-residency-us = <0x1e8480>;
				compatible = "arm,idle-state";
				exit-latency-us = <0x1e8480>;
				entry-latency-us = <0x1e8480>;
				phandle = <0x84>;
				arm,psci-suspend-param = <0x2010000>;
			};

			cpu-sleep-0 {
				linux,phandle = <0x82>;
				min-residency-us = <0x12c0>;
				compatible = "arm,idle-state";
				exit-latency-us = <0x21c>;
				entry-latency-us = <0x8c>;
				phandle = <0x82>;
				arm,psci-suspend-param = <0x10000>;
			};

			cluster-sleep-0 {
				linux,phandle = <0x83>;
				min-residency-us = <0x2710>;
				compatible = "arm,idle-state";
				exit-latency-us = <0x3e8>;
				entry-latency-us = <0x1f4>;
				phandle = <0x83>;
				arm,psci-suspend-param = <0x1010000>;
			};
		};
	};

	dram_opp_table {
		linux,phandle = <0x86>;
		compatible = "operating-points-v2";
		phandle = <0x86>;

		opp00 {
			opp-hz = <0x00 0x7de2900>;
			opp-microvolt = <0xdbba0>;
		};

		opp01 {
			opp-hz = <0x00 0xa7d8c00>;
			opp-microvolt = <0xdbba0>;
		};

		opp02 {
			opp-hz = <0x00 0xfbc5200>;
			opp-microvolt = <0xdbba0>;
		};

		opp03 {
			opp-hz = <0x00 0x1f78a400>;
			opp-microvolt = <0xdbba0>;
		};
	};

	n_brom {
		compatible = "allwinner,n-brom";
		reg = <0x00 0x00 0x00 0xc000>;
	};

	timer_arch {
		interrupt-parent = <0x85>;
		compatible = "arm,armv7-timer";
		clock-frequency = <0x16e3600>;
		arm,cpu-registers-not-fw-configured;
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
	};

	interrupt-controller@03020000 {
		#interrupt-cells = <0x03>;
		linux,phandle = <0x85>;
		interrupt-parent = <0x85>;
		interrupt-controller;
		compatible = "arm,cortex-a15-gic\0arm,cortex-a9-gic";
		#address-cells = <0x00>;
		device_type = "gic";
		reg = <0x00 0x3021000 0x00 0x1000 0x00 0x3022000 0x00 0x2000 0x00 0x3024000 0x00 0x2000 0x00 0x3026000 0x00 0x2000>;
		phandle = <0x85>;
		interrupts = <0x01 0x09 0xf04>;
	};

	uboot {
	};

	sram_ctrl {
		compatible = "allwinner,sram_ctrl";
		device_type = "sram_ctrl";
		reg = <0x00 0x3000000 0x00 0x100>;
	};

	dram {
		dram_tpr9 = <0x00>;
		dram_tpr0 = <0x4a2195>;
		dram_tpr11 = <0x210000>;
		dram_para2 = <0x800000>;
		dram_mr2 = <0x18>;
		dram_tpr1 = <0x2423190>;
		dram_zq = <0x3bfb>;
		dram_tpr2 = <0x8b061>;
		compatible = "allwinner,dram";
		dram_mr3 = <0x00>;
		dram_tpr12 = <0x55>;
		dram_para1 = <0x10d2>;
		dram_tpr3 = <0xb4787896>;
		dram_tpr8 = <0x00>;
		dram_tpr13 = <0x14006903>;
		dram_mr1 = <0x02>;
		dram_tpr10 = <0x00>;
		dram_mr0 = <0x1c70>;
		dram_tpr4 = <0x00>;
		dram_tpr5 = <0x00>;
		device_type = "dram";
		dram_tpr6 = <0x00>;
		dram_odt_en = <0x00>;
		dram_tpr7 = <0x1621121e>;
		clock-names = "pll_ddr";
		dram_clk = <0x318>;
		dram_type = <0x03>;
	};

	interrupt-controller@0 {
		#interrupt-cells = <0x03>;
		linux,phandle = <0x01>;
		interrupt-parent = <0x85>;
		interrupt-controller;
		compatible = "allwinner,sunxi-wakeupgen";
		phandle = <0x01>;
	};

	ion {
		compatible = "allwinner,sunxi-ion";

		heap_sys_user@0 {
			heap-type = "ion_system";
			compatible = "allwinner,sys_user";
			heap-name = "sys_user";
			heap-base = <0x00>;
			heap-id = <0x00>;
			heap-size = <0x00>;
		};

		heap_cma@0 {
			heap-type = "ion_cma";
			compatible = "allwinner,cma";
			heap-name = "cma";
			heap-base = <0x00>;
			heap-id = <0x04>;
			heap-size = <0x00>;
		};

		heap_secure@0 {
			heap-type = "ion_secure";
			compatible = "allwinner,secure";
			heap-name = "secure";
			heap-base = <0x00>;
			heap-id = <0x06>;
			heap-size = <0x00>;
		};

		heap_sys_contig@0 {
			heap-type = "ion_contig";
			compatible = "allwinner,sys_contig";
			heap-name = "sys_contig";
			heap-base = <0x00>;
			heap-id = <0x01>;
			heap-size = <0x00>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	soc@03000000 {
		compatible = "simple-bus";
		#size-cells = <0x02>;
		#address-cells = <0x02>;
		device_type = "soc";
		ranges;

		tkey_para {
			tkey_used = <0x00>;
			tkey_int;
			tkey_twi_id;
			device_type = "tkey_para";
			tkey_twi_addr;
		};

		watchdog@030090a0 {
			compatible = "allwinner,sun50i-wdt";
			reg = <0x00 0x30090a0 0x00 0x20>;
			interrupts = <0x00 0x38 0x04>;
		};

		ce@1904000 {
			device_name = "ce";
			compatible = "allwinner,sunxi-ce";
			clock-frequency = <0x11e1a300>;
			clocks = <0x6f 0x70>;
			reg = <0x00 0x1904000 0x00 0xa0 0x00 0x1904800 0x00 0xa0>;
			interrupts = <0x00 0x41 0x01 0x00 0x42 0x01>;
		};

		cpuscfg@07000400 {
			cpu-soft-entry;
			compatible = "allwinner,sunxi-cpuscfg";
			reg = <0x00 0x7000400 0x00 0x800>;
		};

		smc_para {
			smc_rst;
			smc_vppp;
			smc_vppen;
			smc_sda;
			smc_sck;
			smc_vccen;
			smc_used;
			smc_det;
			device_type = "smc_para";
		};

		pwm@0300a000 {
			pwm-number = <0x08>;
			compatible = "allwinner,sunxi-pwm";
			pwms = <0x54 0x55 0x56 0x57 0x58 0x59 0x5a 0x5b>;
			clocks = <0x53>;
			reg = <0x00 0x300a000 0x00 0x3ff>;
			pwm-base = <0x00>;
		};

		uart_para {
			pinctrl-0 = <0x88>;
			device_type = "uart_para";
			uart_debug_port = <0x00>;
		};

		vind@0 {
			vind0_clk = <0x11e1a300>;
			status = "okay";
			compatible = "allwinner,sunxi-vin-media\0simple-bus";
			pinctrl-names = "mclk0-default\0mclk0-sleep";
			#size-cells = <0x02>;
			#address-cells = <0x02>;
			device_id = <0x00>;
			clocks = <0x02 0x05 0x02>;
			ranges;
			reg = <0x00 0x6600000 0x00 0x1000>;

			scaler@0 {
				status = "okay";
				compatible = "allwinner,sunxi-scaler";
				device_id = <0x00>;
				reg = <0x00 0x2101000 0x00 0x400>;
			};

			scaler@1 {
				status = "okay";
				compatible = "allwinner,sunxi-scaler";
				device_id = <0x01>;
				reg = <0x00 0x2101400 0x00 0x400>;
			};

			actuator@0 {
				actuator0_af_pwdn;
				linux,phandle = <0x6d>;
				status = "disabled";
				actuator0_slave = <0x18>;
				compatible = "allwinner,sunxi-actuator";
				actuator0_afvdd_vol = <0x2ab980>;
				actuator0_name = "ad5820_act";
				actuator0_afvdd = "afvcc-csi";
				device_type = "actuator0";
				phandle = <0x6d>;
			};

			sensor@1 {
				sensor1_hflip = <0x00>;
				act_handle;
				sensor1_dvdd_vol = <0x16e360>;
				status = "okay";
				sensor1_power_en;
				flash_handle;
				sensor1_avdd = "avdd-csi";
				sensor1_iovdd = "iovdd-csi";
				sensor1_twi_addr = <0x6c>;
				sensor1_dvdd = "dvdd-csi-18";
				sensor1_iovdd_vol = <0x2ab980>;
				sensor1_pwdn = <0x1e 0x04 0x0f 0x01 0x00 0x01 0x00>;
				sensor1_fmt = <0x00>;
				sensor1_reset = <0x1e 0x04 0x0e 0x01 0x00 0x01 0x00>;
				sensor1_isp_used = <0x00>;
				device_type = "sensor1";
				sensor1_stby_mode = <0x00>;
				sensor1_twi_cci_id = <0x01>;
				sensor1_vflip = <0x00>;
				sensor1_pos = "front";
				sensor1_avdd_vol = <0x2ab980>;
				sensor1_mname = "ov5647";
			};

			vinc@1 {
				vinc1_sensor_list = <0x00>;
				status = "okay";
				compatible = "allwinner,sunxi-vin-core";
				vinc1_isp_sel = <0x00>;
				vinc1_front_sensor_sel = <0x01>;
				device_id = <0x01>;
				device_type = "vinc1";
				vinc1_csi_sel = <0x03>;
				reg = <0x00 0x6609200 0x00 0x200>;
				vinc1_rear_sensor_sel = <0x00>;
				interrupts = <0x00 0x46 0x04>;
			};

			vinc@0 {
				vinc0_isp_sel = <0x00>;
				vinc0_rear_sensor_sel = <0x00>;
				status = "okay";
				compatible = "allwinner,sunxi-vin-core";
				vinc0_csi_sel = <0x03>;
				vinc0_front_sensor_sel = <0x01>;
				vinc0_sensor_list = <0x00>;
				device_id = <0x00>;
				device_type = "vinc0";
				reg = <0x00 0x6609000 0x00 0x200>;
				interrupts = <0x00 0x45 0x04>;
			};

			isp@0 {
				status = "okay";
				compatible = "allwinner,sunxi-isp";
				device_id = <0x00>;
				reg = <0x00 0x2100000 0x00 0x800>;
				interrupts = <0x00 0x17 0x04>;
			};

			flash@0 {
				linux,phandle = <0x6c>;
				status = "disabled";
				compatible = "allwinner,sunxi-flash";
				flash0_flvdd_vol;
				flash0_flvdd = [00];
				device_id = <0x00>;
				flash0_mode;
				flash0_en;
				device_type = "flash0";
				flash0_type = <0x02>;
				phandle = <0x6c>;
			};

			sensor@0 {
				act_handle = <0x6d>;
				sensor0_stby_mode = <0x00>;
				status = "okay";
				sensor0_power_en;
				sensor0_pos = "rear";
				sensor0_reset = <0x1e 0x04 0x0e 0x01 0x00 0x01 0x00>;
				flash_handle = <0x6c>;
				sensor0_avdd_vol = <0x2ab980>;
				sensor0_dvdd_vol = <0x16e360>;
				sensor0_dvdd = "dvdd-csi-18";
				sensor0_twi_cci_id = <0x00>;
				sensor0_vflip = <0x00>;
				sensor0_fmt = <0x00>;
				sensor0_isp_used = <0x00>;
				device_type = "sensor0";
				sensor0_iovdd_vol = <0x2ab980>;
				sensor0_iovdd = "iovdd-csi";
				sensor0_pwdn = <0x1e 0x04 0x10 0x01 0x00 0x01 0x00>;
				sensor0_mname = "ov5640";
				sensor0_twi_addr = <0x78>;
				sensor0_hflip = <0x00>;
			};
		};

		gpio-ir {
			linux,pwm-port = <0x04>;
			status = "okay";
			compatible = "sunxi-gpio-ir";
			recv-gpio = <0x1e 0x01 0x03 0x06 0x01 0x01 0x01>;
			linux,tx-pwm-mode;
			linux,ir-rx-protos = <0x02 0x09 0x0e>;
			linux,tx-enable;
			linux,rc-map-name = "rc-aw-nec";
		};

		wlan {
			wlan_busnum = <0x01>;
			wlan_regon = <0x1e 0x04 0x06 0x01 0x01 0x01 0x00>;
			status = "okay";
			compatible = "allwinner,sunxi-wlan";
			wlan_hostwake = <0x1e 0x04 0x05 0x06 0xffffffff 0xffffffff 0xffffffff>;
			device_type = "wlan";
			clocks = "losc_out";
		};

		uart@05000400 {
			pinctrl-0 = <0x90>;
			status = "okay";
			compatible = "allwinner,sun8i-uart";
			pinctrl-names = "default\0sleep";
			uart1_type = <0x04>;
			pinctrl-1 = <0x91>;
			uart1_port = <0x01>;
			device_type = "uart1";
			clocks = <0x0f>;
			reg = <0x00 0x5000400 0x00 0x400>;
			interrupts = <0x00 0x4d 0x04>;
		};

		btlpm {
			bt_wake = <0x1e 0x04 0x03 0x01 0xffffffff 0xffffffff 0x01>;
			status = "okay";
			compatible = "allwinner,sunxi-btlpm";
			uart_index = <0x01>;
			bt_hostwake = <0x1e 0x04 0x00 0x06 0xffffffff 0xffffffff 0x00>;
			device_type = "btlpm";
		};

		s_cir0 {
			ir_power_key_code0 = <0x57>;
			ir_addr_cnt = <0x01>;
			status = "okay";
			device_type = "s_cir0";
			ir_protocol_used = <0x00>;
			ir_addr_code0 = <0x9f00>;
		};

		dma-controller@03002000 {
			#dma-cells = <0x01>;
			compatible = "allwinner,sun8i-dma";
			clocks = <0x0a>;
			reg = <0x00 0x3002000 0x00 0x1000>;
			interrupts = <0x00 0x22 0x04>;
		};

		3g_para {
			3g_usbc_num = <0x02>;
			3g_uart_num = <0x00>;
			3g_used = <0x00>;
			3g_int;
			device_type = "3g_para";
		};

		idc@0x08130000 {
			irq_channel_array = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			device_name = "idc";
			status = "okay";
			compatible = "allwinner,sunxi-idc";
			channel_delay_cycle = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			irq_delay_en = <0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
			reg = <0x00 0x8130000 0x00 0x338>;
			wfi_check_en = <0x00>;
		};

		ohci0-controller@0x05101400 {
			status = "okay";
			compatible = "allwinner,sunxi-ohci0";
			hci_ctrl_no = <0x00>;
			clocks = <0x1f 0x22 0x23 0x24 0x05 0x0b>;
			reg = <0x00 0x5101000 0x00 0xfff 0x00 0x00 0x00 0x100 0x00 0x5100000 0x00 0x1000>;
			interrupts = <0x00 0x27 0x04>;
		};

		cpu_budget_cool {
			linux,phandle = <0x79>;
			status = "okay";
			compatible = "allwinner,budget_cooling";
			#cooling-cells = <0x02>;
			state0 = <0x124f80 0x02>;
			phandle = <0x79>;
			state_cnt = <0x02>;
			state1 = <0xafc80 0x02>;
			cluster_num = <0x01>;
		};

		compass_para {
			compass_twi_addr = <0x0d>;
			compass_int = <0x1e 0x00 0x0b 0x06 0x01 0xffffffff 0xffffffff>;
			device_type = "compass_para";
			compass_twi_id = <0x02>;
			compass_used = <0x01>;
		};

		keyboard {
			key0 = <0xa4 0x73>;
			status = "okay";
			key3 = <0x384 0xa4>;
			wakeup-source;
			key1 = <0x19f 0x72>;
			compatible = "allwinner,keyboard_1350mv";
			key2 = <0x286 0x71>;
			key4 = <0x485 0x66>;
			reg = <0x00 0x5070800 0x00 0x400>;
			key_cnt = <0x04>;
			interrupts = <0x00 0x32 0x00>;
		};

		spi@05010000 {
			pinctrl-0 = <0x46 0x47>;
			status = "disabled";
			compatible = "allwinner,sun8i-spi";
			clock-frequency = <0x5f5e100>;
			spi0_cs_number = <0x02>;
			pinctrl-names = "default\0sleep";
			#size-cells = <0x00>;
			pinctrl-1 = <0x48>;
			spi0_cs_bitmap = <0x03>;
			#address-cells = <0x01>;
			device_type = "spi0";
			clocks = <0x02 0x45>;
			reg = <0x00 0x5010000 0x00 0x1000>;
			interrupts = <0x00 0x51 0x04>;

			spi_board0 {
				spi-rx-bus-width = <0x01>;
				compatible = "m25p80";
				device_type = "spi_board0";
				spi-max-frequency = <0xf4240>;
				reg = <0x00>;
				spi-tx-bus-width = <0x01>;
			};
		};

		uart@05000000 {
			uart_type = <0x02>;
			uart_used = <0x01>;
			pinctrl-0 = <0x8e>;
			status = "okay";
			compatible = "allwinner,sun8i-uart";
			pinctrl-names = "default\0sleep";
			uart0_type = <0x02>;
			pinctrl-1 = <0x8f>;
			uart_port = <0x00>;
			device_type = "uart0";
			clocks = <0x0d>;
			uart0_port = <0x00>;
			reg = <0x00 0x5000000 0x00 0x400>;
			interrupts = <0x00 0x4c 0x04>;
		};

		card_boot {
			logical_start = <0xa000>;
			device_type = "card_boot";
			sprite_gpio0;
		};

