		lv4_freq = <0x269fb200>;
		lv5_freq = <0x00>;
		LV8_volt = <0x384>;
		LV7_freq = <0x00>;
		LV3_volt = <0x44c>;
		lv8_volt = <0x410>;
		lv1_freq = <0x47868c00>;
		lv7_freq = <0x00>;
		lv3_freq = <0x30a32c00>;
