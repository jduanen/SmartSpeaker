cpp = meson.get_compiler('cpp')

# Include paths: project root (for config.h) and the include/ tree
# (pa_ringbuffer/pa_memorybarrier pulled from the device).
_incDirs = [
  include_directories('..'),
  include_directories('../include'),
  include_directories('../include/audio'),
  include_directories('../include/audio/alsa'),
  include_directories('../include/esphome'),
  include_directories('../third_party/nanopb'),
  include_directories('../third_party/dr_libs'),
]

# ── Dependencies ───────────────────────────────────────────────────────────────
#
# Only libraries present on the stock Xiaodu rootfs (see README "What Stock
# Means"); everything else is vendored. libstdc++ is linked statically.

_deps = []

# glib-2.0: main loop, signals (glib-unix), logging, key files
_deps += dependency('glib-2.0')

# gio-2.0: sockets for the ESPHome API server
_deps += dependency('gio-2.0')

# ALSA: audio capture/playback via hw:* devices
_deps += dependency('alsa')

# libcurl: fetching media and TTS URLs
_deps += dependency('libcurl')

# speexdsp: acoustic echo cancellation and audio preprocessing
_deps += dependency('speexdsp')

# POSIX threads: std::thread in AudioInput and AudioPlayer
_deps += dependency('threads')

# Vendored wake word inference (third_party/meson.build)
_deps += [tflm_dep, micro_speech_features_dep]

# ── Source files ───────────────────────────────────────────────────────────────

_sources = [
  'main.cpp',
  'app.cpp',
  'config.cpp',
  'leds.cpp',
  'evinput.cpp',

  # State machine
  'state/state.cpp',
  'state/sleeping.cpp',
  'state/listening.cpp',
  'state/processing.cpp',
  'state/saying.cpp',
  'state/config.cpp',
  'state/ringing.cpp',

  # Assist voice pipeline
  'voice/session.cpp',

  # Audio subsystem
  'audio/audioinput.cpp',
  'audio/audioplayer.cpp',
  'audio/audiovolume.cpp',
  'audio/wakeword.cpp',

  # ALSA backend
  'audio/alsa/input.cpp',
  'audio/alsa/audiofifo.cpp',
  'audio/alsa/volume.cpp',
  'audio/alsa/pa_ringbuffer.c',   # C file; meson handles mixed C/C++ automatically

  # Playback engine
  'audio/mixer.cpp',
  'audio/source.cpp',
  'audio/decoder.cpp',
  'audio/stream.cpp',
  'audio/dr_libs.c',              # dr_flac/dr_mp3/dr_wav implementations

  # ESPHome native API
  'esphome/frame.cpp',
  'esphome/server.cpp',
  'esphome/entities.cpp',
  'esphome/api.pb.c',             # generated by scripts/gen_proto.py

  # nanopb runtime (third_party/nanopb, 0.4.9.1)
  '../third_party/nanopb/pb_common.c',
  '../third_party/nanopb/pb_encode.c',
  '../third_party/nanopb/pb_decode.c',
]

# glibc 2.23 shims use ARM syscall numbers; only for the armhf cross build
if host_machine.cpu_family() == 'arm'
  _sources += 'glibc_compat.c'
endif

_cpp_args = ['-DG_LOG_USE_STRUCTURED=1', '-DPB_ENABLE_MALLOC']
if get_option('dump_streams')
  # raw mic/reference/AEC-output dumps in /tmp (src/audio/alsa/input.cpp)
  _cpp_args += '-DDEBUG_DUMP_STREAMS'
endif

executable(
  app_command,
  _sources,
  cpp_args : _cpp_args,
  c_args : ['-DPB_ENABLE_MALLOC'],
  include_directories : _incDirs,
  dependencies : _deps,
  install : true,
)
